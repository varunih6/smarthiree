# Copy this file to ".env" (same folder) and edit.

# ---------- Database ----------
# Hackathon spec = in-memory SQLite (data resets when the server restarts).
DATABASE_URL=sqlite:///:memory:
# Want data to survive restarts while developing? use:
# DATABASE_URL=sqlite:///./smarthire.db

# ---------- Auth ----------
JWT_SECRET=please-change-this-to-a-long-random-string
JWT_EXPIRE_MINUTES=480

# ---------- The ONE master admin (hard-coded, stored hashed in DB at startup) ----------
MASTER_ADMIN_NAME=Master Admin
MASTER_ADMIN_EMAIL=admin@smarthire.com
MASTER_ADMIN_PASSWORD=Admin@123

# ---------- LLM ----------
# mock              -> no key needed, keyword-based scoring (good for demos/offline)
# openai            -> set LLM_API_KEY (model default gpt-4o-mini)
# anthropic         -> set LLM_API_KEY (model default claude-haiku-4-5-20251001)
# openai_compatible -> Groq / Gemini / OpenRouter / Ollama: set LLM_BASE_URL + LLM_API_KEY + LLM_MODEL
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
LLM_TIMEOUT=40
LLM_FALLBACK_TO_HEURISTIC=true

# Examples:
# Groq (free tier):  LLM_PROVIDER=openai_compatible  LLM_BASE_URL=https://api.groq.com/openai/v1  LLM_MODEL=llama-3.1-8b-instant
# Gemini:            LLM_PROVIDER=openai_compatible  LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai  LLM_MODEL=gemini-2.0-flash
# Ollama (local):    LLM_PROVIDER=openai_compatible  LLM_BASE_URL=http://localhost:11434/v1  LLM_MODEL=llama3.1

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
